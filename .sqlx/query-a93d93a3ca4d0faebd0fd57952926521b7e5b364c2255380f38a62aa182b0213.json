  "db_name": "PostgreSQL",
  "query": "SELECT i.tenant_id, i.handle, i.role, i.expires_at,\n                      t.display_name, t.slug\n                 FROM invitation i\n                 JOIN tenant t ON t.id = i.tenant_id\n                WHERE i.token_hash = $1\n                  AND i.accepted_at IS NULL AND i.revoked_at IS NULL\n                  AND i.expires_at > now()",
