  "query": "SELECT id, slug, display_name, status, cluster,\n                      database_name, demo_expires_at,\n                      requires_second_factor, created_at\n                 FROM tenant\n                WHERE status = 'provisioning'\n                  AND created_at <= now() - ($1::BIGINT * INTERVAL '1 second')\n                ORDER BY created_at\n                LIMIT $2",
