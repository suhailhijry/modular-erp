  "query": "SELECT c.id as \"id!\", c.name as \"name!\", c.closed as \"closed!\",\n                  count(p.id) as \"postings!\"\n             FROM proj_ledger.cost_center c\n             LEFT JOIN proj_ledger.posting p ON p.cost_center = c.id\n            GROUP BY c.id, c.name, c.closed\n            ORDER BY c.id",
