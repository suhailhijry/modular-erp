  "query": "SELECT id, handle, role,\n                      invited_by as \"invited_by: IdentityId\",\n                      expires_at, created_at\n                 FROM invitation\n                WHERE tenant_id = $1\n                  AND accepted_at IS NULL AND revoked_at IS NULL\n                  AND expires_at > now()\n                ORDER BY created_at DESC",
