  "query": "SELECT topic as \"topic!\", subject_id as \"subject_id!\"\n             FROM message_sent\n            WHERE addressed_to = $1\n              AND sent_at <= $2\n              AND sent_at > $3\n              AND topic IS NOT NULL\n              AND subject_id IS NOT NULL\n            ORDER BY sent_at DESC\n            LIMIT 1",
